---
import AuthorAvatar from "./AuthorAvatar.astro";
---

<footer class="border-light">
  <div class="container flex-row-between-center">
    <div id="copyright-info">
      <span>desarrollado por</span>
      <AuthorAvatar />
    </div>
    <em>Versión 0.2.0</em>
  </div>
</footer>

<style>
  footer {
    font-size: 0.7rem;
    background-color: var(--light-blue);
  }

  #copyright-info {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  span {
    text-transform: uppercase;
    font-weight: bold;
  }
</style>
