---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Analytics from "@vercel/analytics/astro";
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Argentina IT</title>
    <link rel="canonical" href="https://argentina-it.vercel.app/" />
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
    <meta
      name="description"
      content="Recopilación de empresas IT en Argentina. Algunas de  suelen tener búsqedas laborales activas."
    />
    <meta property="og:title" content="Empresas IT de Argentina" />
    <meta
      property="og:description"
      content="Recopilación de empresas IT en Argentina. Algunas de  suelen tener búsqedas laborales activas."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://argentina-it.vercel.app/" />
    <meta
      property="og:image"
      content="https://argentina-it.vercel.app/og-image.webp"
    />
    <Analytics />
  </head>
  <body>
    <div id="root">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style>
  html {
    min-width: 320px;
  }

  #root {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main {
    padding: 10px;
    flex: 1;
  }

  @media (min-width: 800px) {
    main {
      padding: 10px 40px;
    }
  }
</style>
