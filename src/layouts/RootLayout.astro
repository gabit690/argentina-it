---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import "../styles/global.css";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Argentina IT</title>
	</head>
	<body>
		<div id="root">
            <Header />
			<main>
                <slot />
			</main>
            <Footer />
		</div>
	</body>
</html>

<style>
	#root {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}

	main {
		padding: 10px;
		flex: 1;
	}
</style>
